+/*
+ * TASK-02 M4: start a simple command with posix_spawn instead of vfork+execve.
+ * Same PATH walk and ENOEXEC -> /bin/sh fallback as shellexec/tryexec; returns the pid,
+ * or -1 so that the caller falls back to the original vfork path (which then produces the
+ * usual diagnostics and 126/127 exit status).
+ */
+static int
+tryspawn(pid_t *pid, char *cmd, char **argv, char **envp)
+{
+	int r = posix_spawn(pid, cmd, NULL, NULL, argv, envp);
+
+	if (r == ENOEXEC) {
+		char *save0 = argv[0], *save1 = argv[-1];
+		char *const path_bshell = _PATH_BSHELL;
+
+		argv[0] = cmd;
+		argv[-1] = path_bshell;
+		r = posix_spawn(pid, path_bshell, NULL, NULL, argv - 1, envp);
+		argv[0] = save0;
+		argv[-1] = save1;
+	}
+	return r;
+}
+
+pid_t
+spawnexec(char **argv, const char *path, int idx)
+{
+	char **envp = environment();
+	pid_t pid;
+	int r;
+
+	if (strchr(argv[0], '/') != NULL)
+		return tryspawn(&pid, argv[0], argv, envp) ? -1 : pid;
+	while (padvance(&path, argv[0]) >= 0) {
+		char *cmdname = stackblock();
+
+		if (--idx < 0 && pathopt == NULL) {
+			r = tryspawn(&pid, cmdname, argv, envp);
+			if (!r)
+				return pid;
+			if (r != ENOENT && r != ENOTDIR)
+				return -1;
+		}
+	}
+	return -1;
+}
+
