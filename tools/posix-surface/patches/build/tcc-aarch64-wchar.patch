Build fix, not a measurement patch. On aarch64 Linux the psABI (and musl's bits/alltypes.h) define
wchar_t as unsigned int; tcc's predefines say int, so any TU that includes both <stddef.h> (tcc) and a
musl header that defines wchar_t fails with "incompatible redefinition of 'wchar_t'".
--- a/include/tccdefs.h
+++ b/include/tccdefs.h
@@ -60,6 +60,9 @@
 #if defined _WIN32
     #define __WCHAR_TYPE__ unsigned short
     #define __WINT_TYPE__ unsigned short
+#elif defined __linux__ && defined __aarch64__
+    #define __WCHAR_TYPE__ unsigned int
+    #define __WINT_TYPE__ unsigned int
 #elif defined __linux__
     #define __WCHAR_TYPE__ int
     #define __WINT_TYPE__ unsigned int
