# vim (the host's vi) editing a small file: the alternate screen, the status line,
# insert mode, a scroll, a search, and the shell's screen coming back.
size 80 24
run vi -u NONE -N -n -i NONE --cmd "set nocp ruler showcmd laststatus=2 t_RV= t_u7=" -c "syntax on" -c "set background=dark" notes.txt
file notes.txt # Notes\nThe quick brown fox jumps over the lazy dog.\nA second line, with a tab:\there.\nTODO: write the terminal.\n\n    indented line\nlast line\n
mark start
send G
wait 1
mark at the last line
send ohello from the editor\e
wait 1
mark after typing
send gg
wait 1
send /fox\r
wait 1
mark after a search
send :set number\r
wait 1
mark with line numbers
send :q!\r
wait 1
mark after quitting
