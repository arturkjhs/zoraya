+class _PipeEnd:
+    """One end of an os.pipe(), with the socket methods the loop's
+    self-pipe uses."""
+
+    def __init__(self, fd):
+        self._fd = fd
+
+    def fileno(self):
+        return self._fd
+
+    def setblocking(self, flag):
+        os.set_blocking(self._fd, flag)
+
+    def recv(self, n):
+        return os.read(self._fd, n)
+
+    def send(self, data):
+        return os.write(self._fd, data)
 
+    def close(self):
+        fd, self._fd = self._fd, -1
+        if fd >= 0:
+            os.close(fd)
 
+
