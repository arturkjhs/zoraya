+#elif defined(__zoraya__)
+/* Zoraya (ADR-0461, ADR-0310 item 5): the only entropy source is getrandom.
+ * No device file is opened and none is named in the program. */
+#include <sys/random.h>
+
+int mbedtls_platform_entropy_poll(void *data,
+                                  unsigned char *output, size_t len, size_t *olen)
+{
+    ssize_t n;
+    ((void) data);
+
+    *olen = 0;
+    n = getrandom(output, len, 0);
+    if (n < 0) {
+        return MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;
+    }
+    *olen = (size_t) n;
+    return 0;
+}
