Zoraya (ADR-0336 item 2, the gate review of TASK-31 10e, G1 G2 G3 G4 G7): bounds
and errors in three commands of toys/pending. tr: grow the set before an item
that adds up to 256 bytes (a heap overflow), stop at SET2's length rather than
at a NUL byte, and end on a read error instead of spinning. diff -F: the loop
tests its own index. expr: compare without subtracting, and fail on overflow
(exit 2) where the result would wrap.

diff -ru a/toys/pending/tr.c b/toys/pending/tr.c
--- a/toys/pending/tr.c
+++ b/toys/pending/tr.c
@@ -51,7 +51,7 @@
   i = k = 0;
   while (!FLAG(d) && set2 && TT.len1--) { //ignore set2 if -d present
     TT.map[set1[i]] = ((TT.map[set1[i]] & 0xFF00) | set2[k]);
-    if (set2[k + 1]) k++;
+    if (k + 1 < TT.len2) k++; // set2 is counted, not terminated
     i++;
   }
 }
@@ -115,7 +115,7 @@
 
   while (*arg) {
     if (arg-orig >= until) break;
-    if (i >= size) {
+    if (i > size - 256) { // one item adds up to 256 bytes
       size += 256;
       set = xrealloc(set, size);
     }
@@ -189,7 +189,7 @@
