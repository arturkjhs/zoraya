+#ifdef __zoraya__
+// Zoraya (ADR-0336 item 6, ADR-0344): a file is changed in place. The result
+// is written to a temporary file in /tmp (the line's own, always given) and,
+// when the work is done, copied back into the original, which the line
+// designated as the one file to change; no sibling is created or renamed over
+// it, so the directory's other names are never needed. The price is that the
+// change is not atomic: a change interrupted after the copy-back starts can
+// leave the file short.
+static char *zoraya_original;
+#endif
+
 // Open a temporary file to copy an existing file into.
 int copy_tempfile(int fdin, char *name, char **tempname)
 {
   struct stat statbuf;
+#ifdef __zoraya__
+  int fd = xtempfile("/tmp/toybox-", tempname), ignored __attribute__((__unused__));
+
+  free(zoraya_original);
+  zoraya_original = xstrdup(name);
+#else
   int fd = xtempfile(name, tempname), ignored __attribute__((__unused__));
+#endif
 
   // Record tempfile for exit cleanup if interrupted
   if (!tempfile2zap) sigatexit(tempfile_handler);
@@ -808,6 +826,29 @@
   *tempname = NULL;
 }
 
+#ifdef __zoraya__
+// Copy the rest of the data, then the whole copy back into the original.
+void replace_tempfile(int fdin, int fdout, char **tempname)
+{
+  int out;
+
+  if (fdin != -1) {
+    xsendfile(fdin, fdout);
+    xclose(fdin);
+  }
+  xlseek(fdout, 0, SEEK_SET);
+  out = xopen(zoraya_original, O_WRONLY|O_TRUNC);
+  xsendfile(fdout, out);
+  xclose(out);
+  xclose(fdout);
+  unlink(*tempname);
+  tempfile2zap = (char *)1;
+  free(*tempname);
+  free(zoraya_original);
+  zoraya_original = NULL;
+  *tempname = NULL;
+}
+#else
 // Copy the rest of the data and replace the original with the copy.
