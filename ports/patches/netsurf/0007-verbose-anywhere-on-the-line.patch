--- a/netsurf/frontends/framebuffer/gui.c
+++ b/netsurf/frontends/framebuffer/gui.c
@@ -2205,6 +2205,28 @@
 	/* initialise logging. Not fatal if it fails but not much we
 	 * can do about it either.
 	 */
+	/* Zoraya (TASK-27 9d re-review, N1): nslog reads `-v` only as the first
+	 * argument, and getopt ends the program on it anywhere else; the
+	 * description gives `-v` and `--verbose` anywhere on the line. Each is
+	 * taken out and one `-v` put first. */
+	{
+		static char verbose_flag[] = "-v";
+		int i, j = 1, verbose = 0;
+		for (i = 1; i < argc; i++) {
+			if (strcmp(argv[i], "-v") == 0 || strcmp(argv[i], "--verbose") == 0)
+				verbose = 1;
+			else
+				argv[j++] = argv[i];
+		}
+		if (verbose) {
+			for (i = j; i > 1; i--)
+				argv[i] = argv[i - 1];
+			argv[1] = verbose_flag;
+			j++;
+		}
+		argv[j] = NULL;
+		argc = j;
+	}
 	nslog_init(nslog_stream_configure, &argc, argv);
 
 	/* user options setup */
