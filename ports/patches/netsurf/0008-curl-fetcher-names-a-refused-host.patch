+/*
+ * Zoraya (ADR-0325): the last name lookup and how it ended. Every
+ * getaddrinfo of the program comes here (the link's --wrap=getaddrinfo,
+ * ports/netsurf/Makefile.config), so that a refused fetch reads curl's own
+ * lookup instead of asking a second time: curl resolves on NetSurf's only
+ * thread (no threaded resolver), and a lookup that times out would freeze
+ * the window twice as long (9f-net review, finding 5).
+ */
+static struct {
+	char name[256];
+	int rc;
+	int err;
+} zoraya_lookup;
+
+int __real_getaddrinfo(const char *node, const char *service,
+		       const struct addrinfo *hints, struct addrinfo **res);
+int __wrap_getaddrinfo(const char *node, const char *service,
+		       const struct addrinfo *hints, struct addrinfo **res);
+
+int __wrap_getaddrinfo(const char *node, const char *service,
+		       const struct addrinfo *hints, struct addrinfo **res)
+{
+	int rc = __real_getaddrinfo(node, service, hints, res);
+	int err = errno;
+
+	zoraya_lookup.name[0] = '\0';
+	if (node != NULL && strlen(node) < sizeof zoraya_lookup.name) {
+		strcpy(zoraya_lookup.name, node);
+		zoraya_lookup.rc = rc;
+		zoraya_lookup.err = err;
+	}
+	errno = err;
+	return rc;
+}
+
+
 /**
+ * Zoraya (ADR-0325): whether the network service refused this fetch because
+ * the window's grant does not cover its host and port: a connect that failed
+ * with EACCES, or a lookup of its host that failed with EAI_SYSTEM and
+ * EACCES (curl's own, the last one of the program; never asked again).
+ * Other failures are the network's own.
+ */
+static bool zoraya_refused(struct curl_fetch_info *f, CURLcode result, long oserr)
+{
+	lwc_string *host;
+	bool refused;
+
+	if (result == CURLE_COULDNT_CONNECT)
+		return oserr == EACCES;
+	if (result != CURLE_COULDNT_RESOLVE_HOST)
+		return false;
+	host = nsurl_get_component(f->url, NSURL_HOST);
+	if (host == NULL)
+		return false;
+	refused = strcasecmp(zoraya_lookup.name, lwc_string_data(host)) == 0 &&
+		  zoraya_lookup.rc == EAI_SYSTEM && zoraya_lookup.err == EACCES;
+	lwc_string_unref(host);
+	return refused;
+}
+
+/**
+ * Zoraya (ADR-0325): answers a refused fetch with a page of its own (status
+ * 403) that names the host and port and the line that would allow it.
+ * Returns false if the page could not be made (NetSurf's error page then).
+ */
+static bool zoraya_send_refusal(struct curl_fetch_info *f)
+{
+	static const char type[] = "Content-Type: text/html; charset=utf-8\r\n";
+	static char page[ZORAYA_REFUSAL_PAGE_MAX];
+	lwc_string *host, *port, *scheme;
+	unsigned number;
+	size_t n;
+	fetch_msg msg;
+
+	host = nsurl_get_component(f->url, NSURL_HOST);
+	if (host == NULL)
+		return false;
+	port = nsurl_get_component(f->url, NSURL_PORT);
+	scheme = nsurl_get_component(f->url, NSURL_SCHEME);
+	if (port != NULL) {
+		number = (unsigned) strtoul(lwc_string_data(port), NULL, 10);
+	} else {
+		number = (scheme != NULL && strcmp(lwc_string_data(scheme), "https") == 0) ? 443 : 80;
+	}
+	n = zoraya_refusal_page(nsurl_access(f->url), lwc_string_data(host), number, page, sizeof page);
+	lwc_string_unref(host);
+	if (port != NULL)
+		lwc_string_unref(port);
+	if (scheme != NULL)
+		lwc_string_unref(scheme);
+	if (n == 0)
+		return false;
+	NSLOG(netsurf, INFO, "refused by the grant: %s", nsurl_access(f->url));
+	fetch_set_http_code(f->fetch_handle, 403);
+	msg.type = FETCH_HEADER;
+	msg.data.header_or_data.buf = (const uint8_t *) type;
+	msg.data.header_or_data.len = sizeof type - 1;
+	fetch_send_callback(&msg, f->fetch_handle);
+	msg.type = FETCH_DATA;
+	msg.data.header_or_data.buf = (const uint8_t *) page;
+	msg.data.header_or_data.len = n;
+	fetch_send_callback(&msg, f->fetch_handle);
+	msg.type = FETCH_FINISHED;
+	fetch_send_callback(&msg, f->fetch_handle);
+	return true;
+}
