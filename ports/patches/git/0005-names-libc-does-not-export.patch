+	 */
+	error(_("free disk size is not available on this system"));
+	res = -1;
+	goto cleanup;
 #else
 	struct statvfs stat;
 
diff -ruN a/connect.c b/connect.c
--- a/connect.c
+++ b/connect.c
@@ -828,9 +828,14 @@
 static const char *ai_name(const struct addrinfo *ai)
 {
 	static char addr[NI_MAXHOST];
+#ifdef __zoraya__
+	/* Zoraya (ADR-0347): libc.a has no getnameinfo; the address is not printed. */
+	xsnprintf(addr, sizeof(addr), "(unknown)");
+#else
 	if (getnameinfo(ai->ai_addr, ai->ai_addrlen, addr, sizeof(addr), NULL, 0,
 			NI_NUMERICHOST) != 0)
 		xsnprintf(addr, sizeof(addr), "(unknown)");
+#endif
 
 	return addr;
 }
diff -ruN a/upload-pack.c b/upload-pack.c
--- a/upload-pack.c
+++ b/upload-pack.c
@@ -176,7 +176,12 @@
 
 static void reset_timeout(unsigned int timeout)
 {
+#ifndef __zoraya__
 	alarm(timeout);
