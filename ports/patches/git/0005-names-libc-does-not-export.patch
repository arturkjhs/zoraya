diff -ruN a/builtin/help.c b/builtin/help.c
--- a/builtin/help.c
+++ b/builtin/help.c
@@ -18,6 +18,15 @@
 #include "alias.h"
 #include "setup.h"
 
+#ifdef __zoraya__
+/*
+ * Zoraya (ADR-0347): libc.a has no execlp, and no manual viewer or info
+ * reader is in the image (ADR-0339 item 1); starting one fails as an
+ * unoffered call does, and `git help` says no viewer handled the request.
+ */
+#define execlp(file, ...) (errno = ENOSYS, -1)
+#endif
+
 #ifndef DEFAULT_HELP_FORMAT
 #define DEFAULT_HELP_FORMAT "man"
 #endif
diff -ruN a/compat/disk.h b/compat/disk.h
--- a/compat/disk.h
+++ b/compat/disk.h
@@ -33,6 +33,14 @@
 	strbuf_addf(out, "Available space on '%s': ", buf.buf);
 	strbuf_humanise_bytes(out, avail2caller.QuadPart);
 	strbuf_addch(out, '\n');
+#elif defined(__zoraya__)
+	/*
+	 * Zoraya (ADR-0347, ADR-0461's part 10h): libc.a has no statvfs; `git diagnose`
