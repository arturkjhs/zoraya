--- a/git-compat-util.h	2026-11-15 04:04:19
+++ b/git-compat-util.h	2026-11-15 04:04:20
@@ -1142,4 +1142,12 @@
 
 #ifdef DISABLE_SIGN_COMPARE_WARNINGS
 DISABLE_WARNING(-Wsign-compare)
+/*
+ * Zoraya (ADR-0339 item 8): the variables that would decide what is trusted,
+ * which program a prompt or a transport runs, or which configuration is read
+ * are not read: zoraya_getenv answers "not set" for them.
+ */
+char *zoraya_getenv(const char *name);
+#define getenv(name) zoraya_getenv(name)
+
 #endif
--- a/wrapper.c	2026-11-15 04:04:19
+++ b/wrapper.c	2026-11-15 04:04:20
@@ -987,3 +987,24 @@
 		die_errno(_("mmap failed%s"), mmap_os_err());
 	return ret;
 }
+
+#undef getenv
+char *zoraya_getenv(const char *name)
+{
+	static const char *const prefixes[] = {
+		"GIT_SSL_", "GIT_CONFIG_COUNT", "GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_",
+		"GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM", "GIT_CONFIG_NOSYSTEM",
+		"GIT_ASKPASS", "SSH_ASKPASS", "GIT_SSH", "GIT_PROXY_COMMAND",
+		"GIT_PROXY_SSL_", "GIT_HTTP_PROXY_AUTHMETHOD", "GIT_CURL_",
+		"HTTP_PROXY", "HTTPS_PROXY", "http_proxy", "https_proxy",
+		"ALL_PROXY", "all_proxy", "NO_PROXY", "no_proxy", "CURL_CA_BUNDLE",
+		"SSL_CERT_FILE", "SSL_CERT_DIR", "GIT_EXTERNAL_DIFF", "GIT_ALLOW_PROTOCOL",
+		NULL
+	};
+	size_t i;
+
+	for (i = 0; prefixes[i]; i++)
+		if (!strncmp(name, prefixes[i], strlen(prefixes[i])))
+			return NULL;
+	return getenv(name);
+}
