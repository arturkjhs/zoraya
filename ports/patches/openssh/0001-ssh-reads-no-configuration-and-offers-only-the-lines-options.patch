diff --git a/ssh.c b/ssh.c
index fe660ef..04c47b0 100644
--- a/ssh.c
+++ b/ssh.c
@@ -569,6 +569,16 @@ process_config_files(const char *host_name, struct passwd *pw,
 
 	if ((cmd = sshbuf_dup_string(command)) == NULL)
 		fatal_f("sshbuf_dup_string failed");
+#ifdef __zoraya__
+	/*
+	 * Zoraya (ADR-0340 item 3): no configuration file is read, neither
+	 * ~/.ssh/config nor /etc/ssh/ssh_config, and -F is not offered: what the
+	 * line says is the whole of it, so no file can change the host or run
+	 * a program.
+	 */
+	free(cmd);
+	return;
+#endif
 	if (config != NULL) {
 		if (strcasecmp(config, "none") != 0 &&
 		    !read_config_file(config, pw, host, host_name, cmd,
@@ -701,8 +711,17 @@ main(int ac, char **av)
 
  again:
 	/* remaining: HUdhjruz */
+#ifdef __zoraya__
+	/*
+	 * Zoraya (ADR-0340 item 4): only the options ssh.cmd lists. -o, -F, -J,
+	 * -W, -L, -R, -D, -A, -E, -S, -w, -I and -i, which could name another
+	 * host, run a program, listen or read a file, are not in the string.
+	 */
+	while ((opt = getopt(ac, av, "TVtv" "l:p:")) != -1) {
+#else
 	while ((opt = getopt(ac, av, "1246ACGKMNTVXYZafgknqstvxy"
 	    "B:D:E:F:I:J:L:O:P:Q:R:S:W:b:c:e:i:l:m:o:p:w:")) != -1) {
+#endif
 		switch (opt) {
 		case '1':
 			fatal("SSH protocol v.1 is no longer supported");
@@ -1109,10 +1128,16 @@ main(int ac, char **av)
 				host = p;
 			break;
 		}
+#ifndef __zoraya__
+		/*
+		 * OpenSSH reads options again after the host. Zoraya (ADR-0340
+		 * item 4): every word after the host is the far side's command.
+		 */
 		if (ac > 1 && !opt_terminated) {
 			optind = optreset = 1;
 			goto again;
 		}
+#endif
 		ac--, av++;
 	}
 
@@ -1268,6 +1293,13 @@ main(int ac, char **av)
 		cleanup_exit(255);
 
 	if (options.user == NULL) {
+#ifdef __zoraya__
+		/*
+		 * Zoraya (ADR-0340 item 5): the image's one user is not a name on
+		 * another machine; a line without one is refused.
+		 */
+		fatal("no user name: write -l USER or USER@HOST");
+#endif
 		user_was_default = 1;
 		options.user = xstrdup(pw->pw_name);
 	}
