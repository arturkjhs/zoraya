+#ifdef __zoraya__
+	/*
+	 * Zoraya (ADR-0104 item 5, ADR-0142): every command starts with
+	 * posix_spawn, and what forkchild would do in the vfork child is said
+	 * as attributes. With job control the job is new, so its first process
+	 * leads a new group, and the terminal is handed to that group before
+	 * the child runs (POSIX_SPAWN_TCSETPGRP), by the parent; the stop
+	 * signals get their default action. In an interactive shell SIGINT,
+	 * SIGQUIT and SIGTERM do too. If posix_spawn fails, the vfork path
+	 * below runs and reports the error as dash always did.
+	 */
+	{
+		posix_spawnattr_t attr;
+		sigset_t dfl;
+		short flags = 0;
 
+		posix_spawnattr_init(&attr);
+		sigemptyset(&dfl);
+		if (iflag) {
+			sigaddset(&dfl, SIGINT);
+			sigaddset(&dfl, SIGQUIT);
+			sigaddset(&dfl, SIGTERM);
+			flags |= POSIX_SPAWN_SETSIGDEF;
+		}
+#if JOBS
+		if (jp->jobctl) {
+			sigaddset(&dfl, SIGTSTP);
+			sigaddset(&dfl, SIGTTOU);
+			posix_spawnattr_setpgroup(&attr, 0);
+			flags |= POSIX_SPAWN_SETSIGDEF | POSIX_SPAWN_SETPGROUP |
+				 POSIX_SPAWN_TCSETPGRP;
+		}
+#endif
+		if (flags) {
+			posix_spawnattr_setsigdefault(&attr, &dfl);
+			posix_spawnattr_setflags(&attr, flags);
+		}
+		pid = spawnexec(argv, path, idx, &attr);
+		posix_spawnattr_destroy(&attr);
+		if (pid > 0) {
+			forkparent(jp, n, FORK_FG, pid);
+			return jp;
+		}
+	}
