+
+#ifdef __zoraya__
+/*
+ * Zoraya (ADR-0104 item 4, ADR-0142): the broker puts a forked child into its
+ * process group when it creates it, so the shell names, before fork(), the
+ * group that forkparent and forkchild then setpgid to.
+ */
+static pid_t forkgroup(struct job *jp, int mode)
+{
+#if JOBS
+	if (jp && mode != FORK_NOJOB && jp->jobctl)
+		return jp->nprocs == 0 ? ZORAYA_FORK_NEW : jp->ps[0].pid;
+#endif
+	return ZORAYA_FORK_INHERIT;
 }
+#endif
 
