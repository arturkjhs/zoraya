--- a/lib/Makefile
+++ b/lib/Makefile
@@ -63,7 +63,9 @@
 OBJ-x86_64-osx = $(X86_64_O) va_list.o $(OSX_O)
 OBJ-i386-win32 = $(I386_O) chkstk.o $(WIN_O)
 OBJ-x86_64-win32 = $(X86_64_O) chkstk.o $(WIN_O)
-OBJ-arm64 = $(ARM64_O) armflush.o $(LIN_O)
+# Zoraya: armflush.o's __clear_cache serves -run only, which tcc for Zoraya
+# does not have (ADR-0109 item 7), and on arm64 it compiles only with tcc.
+OBJ-arm64 = $(ARM64_O) $(if $(CONFIG_Zoraya),,armflush.o) $(LIN_O)
 OBJ-arm64-osx = $(ARM64_O) $(OSX_O)
 OBJ-arm64-win32 = $(ARM64_O) chkstk.o $(WIN_O)
 OBJ-arm = $(ARM_O) $(LIN_O)
