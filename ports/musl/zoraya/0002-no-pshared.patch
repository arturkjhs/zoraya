diff -ru a/src/thread/pthread_barrierattr_setpshared.c b/src/thread/pthread_barrierattr_setpshared.c
--- a/src/thread/pthread_barrierattr_setpshared.c
+++ b/src/thread/pthread_barrierattr_setpshared.c
@@ -3,6 +3,8 @@
 int pthread_barrierattr_setpshared(pthread_barrierattr_t *a, int pshared)
 {
 	if (pshared > 1U) return EINVAL;
+	/* ADR-0302 item 6: no wake across processes (ADR-0301 item 3). */
+	if (pshared == 1) return ENOTSUP;
 	a->__attr = pshared ? INT_MIN : 0;
 	return 0;
 }
diff -ru a/src/thread/pthread_condattr_setpshared.c b/src/thread/pthread_condattr_setpshared.c
--- a/src/thread/pthread_condattr_setpshared.c
+++ b/src/thread/pthread_condattr_setpshared.c
@@ -3,6 +3,8 @@
 int pthread_condattr_setpshared(pthread_condattr_t *a, int pshared)
 {
 	if (pshared > 1U) return EINVAL;
+	/* ADR-0302 item 6: no wake across processes (ADR-0301 item 3). */
+	if (pshared == 1) return ENOTSUP;
 	a->__attr &= 0x7fffffff;
 	a->__attr |= (unsigned)pshared<<31;
 	return 0;
