# NetSurf 3.11's build configuration for Zoraya (ADR-0318), copied into the unpacked
# tree's netsurf/ by `make -f ports/Makefile netsurf`. ZORAYA_DEPS is the prefix of
# the libraries (build/ports/deps), given on the make command line.

# The surface libnsfb draws on is chosen at run time; this variable is only a label.
NETSURF_FB_FRONTEND := ram
NETSURF_FB_FONTLIB := internal
NETSURF_FB_RESPATH := /share/netsurf

NETSURF_USE_CURL := YES
NETSURF_USE_OPENSSL := YES
NETSURF_USE_JPEG := YES
NETSURF_USE_PNG := YES
NETSURF_USE_BMP := YES
NETSURF_USE_GIF := YES
NETSURF_USE_NSPSL := YES
NETSURF_USE_NSLOG := YES
NETSURF_USE_UTF8PROC := YES
NETSURF_USE_NSSVG := NO
NETSURF_USE_ROSPRITE := NO
NETSURF_USE_JPEGXL := NO
NETSURF_USE_WEBP := NO
NETSURF_USE_VIDEO := NO
NETSURF_USE_DUKTAPE := NO
NETSURF_USE_HARU_PDF := NO
NETSURF_STRIP_BINARY := NO
NETSURF_FS_BACKING_STORE := NO
NETSURF_USE_LIBICONV_PLUG := YES
NETSURF_LOG_LEVEL := WARNING

# libjpeg has no .pc file; the libraries curl and OpenSSL need come through libcurl.pc.
CFLAGS += -O2 -I$(ZORAYA_DEPS)/include
LDFLAGS += -L$(ZORAYA_DEPS)/lib -lnsshim
