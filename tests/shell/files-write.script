# First boot of the roadmap's criterion, and every file command with its
# errors (TASK-11, rebuilt for the native shell in TASK-18 step 6).
! panicked
! storage failed
! VolumeGone
< Type help to begin, or help tour.
< \r\n~> 
# The shell starts in an empty home (ADR-0154 rule 9).
> pwd\r
< \r\n/home
< \r\n~> 
> ls\r
< \r\n~> 
> cd /\r
< \r\n/> 
> ls\r
< README\r\nconfig/\r\ndocs/\r\nhello.txt\r\nhome/
< \r\n/> 
> cat hello.txt\r
< hello from the filesystem
< \r\n/> 
> cat missing\r
< cat: missing: not found
< \r\n/> 
> cat docs\r
< cat: docs: 
< \r\n/> 
> echo first line > /notes.txt\r
< \r\n/> 
> echo second line >> notes.txt\r
< \r\n/> 
> cat notes.txt\r
< first line\r\nsecond line
< \r\n/> 
> stat notes.txt\r
< file size 23 mtime 
< \r\n/> 
> stat docs\r
< directory size
< \r\n/> 
> stat missing\r
< stat: missing: not found
< \r\n/> 
> mkdir work\r
< \r\n/> 
> mkdir work\r
< mkdir: work: already exists
< \r\n/> 
> mkdir no/such/place\r
< mkdir: no/such/place: not found
< \r\n/> 
> cd work\r
< \r\n/work> 
> pwd\r
< \r\n/work
< \r\n/work> 
> echo kept > inner.txt\r
< \r\n/work> 
> cd ..\r
< \r\n/> 
> cd missing\r
< cd: missing: not found
< \r\n/> 
> cd hello.txt\r
< cd: hello.txt: not a directory
< \r\n/> 
> ls work\r
< inner.txt
< \r\n/> 
> rm work\r
< rm: work: not empty\r\n  hint: rm --recursive work removes it and everything in it
< \r\n/> 
> rm missing\r
< rm: missing: not found
< \r\n/> 
> echo soon removed > gone.txt\r
< \r\n/> 
> rm gone.txt\r
< \r\n/> 
> cat gone.txt\r
< cat: gone.txt: not found
< \r\n/> 
> echo moved > old.txt\r
< \r\n/> 
> mv old.txt work/new.txt\r
< \r\n/> 
> mv missing other\r
< mv: missing: not found
< \r\n/> 
> cat old.txt\r
< cat: old.txt: not found
< \r\n/> 
# Paths are resolved by the shell: .. at / stays at /.
> cat ../hello.txt\r
< hello from the filesystem
< \r\n/> 
# A refused request leaves no handle behind: more than the shell's table holds.
* 1100 cat ../x\r | cat: ../x: not found
< \r\n/> 
> cat hello.txt\r
< hello from the filesystem
< \r\n/> 
> mv\r
< mv: missing operand FROM\r\nusage: mv FROM TO
< \r\n/> 
> sync\r
< \r\n/> 
> echo the shell never asked > unsynced.txt\r
< \r\n/> 
> poweroff\r
