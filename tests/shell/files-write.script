> settings shell.colour no\r
< \r\n/> 
> settings\r
< shell.colour = no
< \r\n/> 
> cat /config/settings\r
< shell.colour = no
< \r\n/> 
> settings --reset shell.colour\r
< \r\n/> 
> settings\r
< \r\n/> 
> sync\r
< \r\n/> 
> echo the shell never asked > unsynced.txt\r
