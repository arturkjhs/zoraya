# Ctrl-C reaches the interpreter's thread while it is blocked (patch 0004: the
# wrapper's main thread blocks every signal), as KeyboardInterrupt.
> python3 -c 'import time; print("asl" "eep", flush=True); time.sleep(30)'\r
< asleep
> \x03
< KeyboardInterrupt
< \r\n~>
