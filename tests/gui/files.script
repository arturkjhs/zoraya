# Stage 7e's criterion (TASK-24, docs/research/desktop/plan.md, ADR-0167,
# ADR-0168): the file manager opens a file in a test application through
# the panel, read-only; the application then asks the chooser to open a
# file, which it can read and cannot write, and to save one, which it can
# write, and nothing beside it. Coordinates are logical at scale 1
# (1024 x 768): the dock's files icon at (427, 723); each new window 32
# further right and down from the first terminal's frame at (72, 70).
# bg.frame.focused is f7f7f8.
serial init: gui: gpu on its own page
screen Type help to begin, or help tour.
screen ~> _
type echo hello > notes.test\r
screen ~> _
# The file manager from the dock, in home: its window is the second.
click 427 723
pause 1500
click 400 120
region 162 108 100 4 f7f7f8
# What it holds, as the file service answered: the volume to read, ~ to
# change, never / nor /config (INV-0168-2 as changed on 2026-11-10).
serial files: holds +r / +w ~
shot files
# The list: notes.test, its only row; Down and Enter open it with t_open
# (by its extension, .test, the test application's), which reads it and
# cannot write it.
key down
type \r
serial files: opened +r ~/notes.test
serial t_open: opened the opened file: 6 bytes: "hello"
serial t_open: write to the opened file refused
# t_open's window is the third: focus it, then Open through the chooser.
pause 500
click 300 152
region 194 140 100 4 f7f7f8
key tab
type \r
pause 1000
shot open
key down
type \r
serial t_open: given +r notes.test
serial t_open: opened notes.test: 6 bytes: "hello"
serial t_open: write to notes.test refused
# Save (the focus stays on Open across the window's new tree): the
# sheet's name field holds the suggested name; Enter in it saves.
key tab
type \r
pause 1000
key tab
shot save
type \r
serial t_open: given +c nový.txt
serial t_open: saved nový.txt
serial t_open: other.txt beside nový.txt refused
# A drop (ADR-0170): t_open moved aside by its title bar, the file
# manager raised by its own, and notes.test dragged from the list onto
# t_open: files starts the drag when the press moves (within the 500 ms in
# which the compositor takes a drag of a press). t_open gets the file to
# read, and its frame the pill.
drag 300 152 700 450
click 540 120
pause 500
# The file manager, wide, would cover t_open: System+Left tiles it to the
# left half (its body at (1, 64), its first row at y 158).
chord meta left
pause 800
shot tiled
drag 305 158 700 540 100
serial files: dragging notes.test
serial t_open: dropped notes.test
serial t_open: opened notes.test: 6 bytes: "hello"
serial t_open: write to notes.test refused
pause 500
shot drop
# The first terminal (its title bar's right end, beside the tiled file
# manager) sees what was saved, and notes.test unchanged.
click 620 80
region 130 76 100 4 f7f7f8
origin 73 106
type ls\r
screen notes.test
screen nový.txt
type cat notes.test\r
screen hello
screen ~> _
type poweroff\r
exit
