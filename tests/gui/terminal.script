# The roadmap's criterion for stage 5, as TASK-14 makes it: a terminal window
# runs zosh, and keys typed into the window run commands, the file commands
# among them. The screen is read back by exact glyph match (see
# tools/test-runner/src/gui.rs). The serial line's input is closed: keys
# reach zosh only through the window (INV-0097-3). Rebuilt for the native
# shell in TASK-18 step 6.
serial init: gui: gpu on its own page
screen Type help to begin, or help tour.
screen ~> _
# Above and left of the window: the background (bg.desktop). The window's
# frame: the focused colour (accent), around the terminal's 668 x 460
# surface (ADR-0093, ADR-0094; the tokens since TASK-24 7a).
region 0 0 1024 14 cfd6df
region 0 0 14 768 cfd6df
region 15 15 670 1 3b4f6b
region 15 15 1 462 3b4f6b
type echo hi > a.txt\r
screen ~> _
# cat is a program: its output comes back to the window through zosh's
# relay of its out stream (ADR-0152 rule 1, TASK-18 step 8).
type cat a.txt\r
screen hi
screen ~> _
# F12 with one window: focus stays, and typing goes on. (That F12 never reaches a
# client is checked by t_gui: the terminal would send nothing for it anyway.)
key f12
type ls | search a\r
screen a.txt
screen ~> _
# A line wider than the window (80 columns) is redrawn in place (ADR-0154
# rule 8 as changed on 2026-11-04): an edit near its start rewrites its two
# rows, and the row below stays empty; the editor before this drew the
# line again there. Rows are 18 pixels high from y 30 (the compositor's
# origin and the terminal's padding), and an empty row is term.bg.
chord ctrl l
top ~> _
# A whole line in one burst: under TCG term once dropped the keys that
# found its channel to zosh full; it now holds them until the shell reads
# (docs/backlog.md, TASK-24 7a).
type echo aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
window
screen ~> echo aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
screen aaaaaaaaaaaaaaaaaa_
chord ctrl a
key right
key right
key right
key right
key right
type Z
chord ctrl e
window
screen ~> echo Zaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
screen aaaaaaaaaaaaaaaaaaa_
region 30 66 640 18 ffffff
type \r
screen Zaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
screen aaaaaaaaaaa
screen ~> _
# Ukrainian and Czech names and text, drawn by zoraya-text in JetBrains
# Mono and read back exactly (TASK-24 7a, ADR-0162). Until the layouts of
# 7c they cannot be typed: the names come from the image, and Tab
# completes them on the line.
type ls /texts/uk\r
screen звіт-2026.txt
screen ~> _
type cat /texts/uk/
key tab
prefix ~> cat /texts/uk/звіт-2026.txt
type \r
screen Привіт, світе! Ґанок, їжак, єнот.
screen ~> _
type cat /texts/cz/
key tab
prefix ~> cat /texts/cz/příklad.txt
type \r
screen Příliš žluťoučký kůň úpěl ďábelské ódy.
screen ~> _
# The screen of TASK-24's report (docs/research/desktop/shots/7a/).
shot terminal-text
# exit closes the window, and init opens a new one with a new shell, since it
# was the last (ADR-0155's Decision, INV-0155-5).
type exit\r
serial init: shell ended
window
screen Type help to begin, or help tour.
screen ~> _
type echo again\r
screen again
screen ~> _
latency 10
type poweroff\r
exit
