# TASK-27 9d (ADR-0317, ADR-0318): NetSurf in a window of the desktop, on the
# runner's HTTP and TLS servers (tools/test-httpd, pages under /ns/). The page is
# a blue block from a style sheet (200 x 60), a green image (100 x 60, a PNG)
# and a form; the result page is yellow. Coordinates are logical pixels: the
# window's frame is at (105, 103), its page from (105, 168).
serial init: gui: gpu on its own page
screen Type help to begin, or help tour.
screen ~> _
pause 3000
# The window shows the grants of its line as pills (ADR-0317): the roots to read
# and the one host and port it may reach.
type netsurf http://@HOST@:@PORT@/ns/page\r
pause 15000
region 110 175 150 40 0000ff
region 110 235 80 40 00ff00
region 400 300 100 40 ffffff
shot netsurf-http
# The pills on the window's title bar (INV-0317-1): four pills, the URL's
# `+net HOST:PORT`, `web` (ADR-0324, INV-0324-4), +r /system/fonts, which comes
# with the window (ADR-0326), and +r /system/tls (right, ending at the frame's
# edge), with the title bar's own colour between them; the right one's last
# padding column is the pill fill.
region 893 117 1 6 fcfcfc
region 788 116 4 8 f1f1f3
# Measured on a screendump of this step: the net pill 467..623 (its text is
# monospace, `+net 203.0.113.2:PORT`), `web` 630..661, the fonts pill 668..785,
# the gaps at 624..629, 662..667 and 786..791 the title bar's colour.
region 663 116 4 8 f1f1f3
region 625 116 4 8 f1f1f3
region 633 117 2 6 fcfcfc
region 656 117 2 6 fcfcfc
# The fonts pill itself (T5 of the 9f-text review): its first padding columns
# are the pill fill, and so are the net pill's. Without the fonts pill, `web`
# and the net pill move right by 124 pixels (the net pill onto 591..747), so
# 470 is the title bar and 671 is inside the net pill: both lines fail.
region 671 116 3 8 fcfcfc
region 470 116 3 8 fcfcfc
# The form: type into the field, submit with Return; the result page is yellow.
click 160 302
type zoraya\r
pause 6000
shot netsurf-result
region 400 300 100 40 ffff00
region 110 400 150 40 ffff00
# Closed by its cross: the program ends and the terminal has the keys again.
click 122 119
pause 3000
click 300 87
pause 500
type echo closed\r
screen closed
# The wheel scrolls the page under the pointer, 100 pixels a notch (proposed
# ADR-0322): /ns/tall is blue for 1200 pixels, then magenta. Fifteen notches
# toward the person put magenta at the top of the page; fifteen away, blue.
type netsurf http://@HOST@:@PORT@/ns/tall\r
pause 15000
region 110 175 150 40 0000ff
wheel 400 400 down 15
pause 3000
shot netsurf-wheel
region 110 175 150 40 ff00ff
wheel 400 400 up 15
pause 3000
region 110 175 150 40 0000ff
click 122 119
pause 3000
click 300 87
pause 500
type echo closed-wheel\r
screen closed-wheel
# Russian and Ukrainian in the system's fonts (ADR-0326, INV-0326-2): the
# page /ns/cyrillic at scale 1 (tests/gui/netsurf-text.script has scale 2).
# Line 1, ten і: ink where they are, and nothing where ten ж reach on line 2
# (boxes, or the old 8-pixel cells, would make the two lines as wide).
type netsurf http://@HOST@:@PORT@/ns/cyrillic\r
pause 15000
shot netsurf-cyrillic
ink 106 172 70 23 ffffff 300
region 190 172 140 23 ffffff
ink 190 214 140 17 ffffff 500
# Line 3: Ґґ Єє Іі Її.
ink 106 239 125 29 ffffff 400
click 122 119
pause 3000
click 300 87
pause 500
type echo closed-cyrillic\r
screen closed-cyrillic
# No option replaces the roots or turns a check off (INV-0312-1): the line is
# refused by the shell, with no window (ADR-0317 item 6).
type netsurf --ca_bundle=/tmp/x.pem https://test.zoraya:@TLSVALID@/ns/page\r
screen zosh: netsurf: the arguments are not ones its description gives
type netsurf --ca_path=/tmp\r
screen zosh: netsurf: the arguments are not ones its description gives
# HTTPS against the test PKI's root (the same pages, a trusted certificate).
# test.zoraya is the test server, 203.0.113.2 in net.hosts: the gateway, which
# a URL's name on another port than 80 and 443 does not reach under `net web`
# (its rule takes public, non-local answers only, ADR-0328); the `+net` word
# names the host, local answers included (ADR-0223), as the refusal page
# offers.
type +net test.zoraya:@TLSVALID@ netsurf https://test.zoraya:@TLSVALID@/ns/page\r
pause 20000
region 110 175 150 40 0000ff
region 110 235 80 40 00ff00
shot netsurf-https
click 122 119
pause 3000
click 300 87
pause 500
type echo closed2\r
screen closed2
# An expired certificate is refused by the roots, as for curl: no page.
type +net expired.zoraya:@TLSEXPIRED@ netsurf https://expired.zoraya:@TLSEXPIRED@/ns/page\r
pause 15000
shot netsurf-refused
region 110 175 40 20 9e9e9e
# "Proceed" on the privacy error page does not turn verification off: the same
# refusal comes back (the program has no such option, INV-0312-1). The test
# server's log then shows exactly one refused handshake before the mark and at
# least one after it (the Makefile checks both): a click that missed the button
# leaves none after it, and a retry of NetSurf's own shows as two before it.
mark @PORT@ /ns/mark-before-proceed
click 764 471
pause 5000
shot netsurf-refused-again
region 110 175 40 20 9e9e9e
click 122 119
pause 3000
click 300 87
pause 500
type echo closed3\r
screen closed3
# ADR-0324: the web grant. `grants` says it in words (on a clear screen: with
# /system/fonts its lines reach past the window's last row).
chord ctrl l
top ~> _
type grants netsurf\r
prefix net: web 
# A page on one public host (one.web.test, 203.0.113.10 of the test network,
# relayed to the test server) links to a second (two.web.test, .11), to a
# redirect to the second, and to hosts the web rule refuses: 10.0.2.2 (QEMU's
# usual host, private), 127.0.0.1, the gateway 203.0.113.2 on port 80 (public
# by range, but this side of the network) and two.web.test:8080 (not 80 or
# 443), then a redirect to two.web.test:8080 and a name whose only answer is
# private (lan.web.test, 10.0.2.2 in net.hosts: its lookup is refused). Each
# link is a block of 40 pixels, one under the other: cyan, orange, maroon,
# green, navy, olive, pink, azure.
type netsurf 'http://one.web.test/ns/web-a?port=@PORT@'\r
pause 15000
region 110 175 150 20 00ffff
region 110 215 150 20 ff8000
region 110 375 150 20 808000
# `web` between the gaps at 624..629 and 662..667 (the fonts and tls pills
# keep their places). The URL's name on port 80 has no pill of its own
# (ADR-0328, INV-0328-1: the web rule admits it through its public answers),
# so left of the gap is the title bar, where a `+net one.web.test:80` pill
# would end.
region 625 116 4 8 f1f1f3
region 633 117 2 6 fcfcfc
region 656 117 2 6 fcfcfc
region 560 116 60 8 f1f1f3
shot netsurf-web
# The second host by a link: its page is magenta.
click 150 188
pause 8000
region 400 300 200 200 ff00ff
shot netsurf-web-link
# Back (the toolbar's arrow), then the redirect to the second host.
click 118 152
pause 5000
region 110 175 150 20 00ffff
click 150 228
pause 8000
region 400 300 200 200 ff00ff
shot netsurf-web-redirect
# The refused hosts: each gets the page that names it and the line that would
# allow it (ADR-0325), whose background is #ffe4b5.
click 118 152
pause 5000
region 110 255 150 20 800000
click 150 268
pause 8000
region 110 175 20 20 ffe4b5
shot netsurf-web-refused-private
click 118 152
pause 5000
region 110 295 150 20 008000
click 150 308
pause 8000
region 110 175 20 20 ffe4b5
shot netsurf-web-refused-loopback
click 118 152
pause 5000
region 110 335 150 20 000080
click 150 348
pause 8000
region 110 175 20 20 ffe4b5
shot netsurf-web-refused-gateway
click 118 152
pause 5000
region 110 375 150 20 808000
click 150 388
pause 8000
region 110 175 20 20 ffe4b5
shot netsurf-web-refused-port
# A redirect to a refused host gets the page too (ADR-0325: "a refused link or
# redirect"); SLIRP relays two.web.test:8080 to the server, so a leak would be
# in its log.
click 118 152
pause 5000
region 110 415 150 20 ff0080
click 150 428
pause 8000
region 110 175 20 20 ffe4b5
shot netsurf-web-refused-redirect
# A lookup the web rule refuses (every answer private): the page, from curl's
# own lookup (patch 0009 asks no second time).
click 118 152
pause 5000
region 110 455 150 20 0080ff
click 150 468
pause 8000
region 110 175 20 20 ffe4b5
shot netsurf-web-refused-lookup
click 122 119
pause 3000
click 300 87
pause 500
type echo closed-web\r
screen closed-web
# ADR-0328 (INV-0328-1): a URL on another port than 80 and 443. Its name's
# answer is public (two.web.test, relayed on 8080 to the server): the
# public-only name rule reaches it, and the page is lime; the window's pill
# is `+net two.web.test:8080 public` beside `web`.
type netsurf http://two.web.test:8080/ns/web-port\r
pause 15000
region 400 300 200 200 80ff00
region 625 116 4 8 f1f1f3
region 633 117 2 6 fcfcfc
shot netsurf-url-port
click 122 119
pause 3000
click 300 87
pause 500
type echo closed-port\r
screen closed-port
# A name whose only answer is private (lan.web.test, 10.0.2.2 in net.hosts)
# on port 8080: the same rule refuses its lookup, and the page names the host
# and the `+net lan.web.test:8080` word (ADR-0325). Under the old name rule
# the answer was used, the connection failed and NetSurf's own error page
# came instead.
type netsurf http://lan.web.test:8080/ns/must-not-reach\r
pause 15000
region 110 175 20 20 ffe4b5
shot netsurf-url-refused-private
click 122 119
pause 3000
click 300 87
pause 500
type echo closed-lan\r
screen closed-lan
type poweroff\r
exit
