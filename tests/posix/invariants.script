# tr, expr and diff of toys/pending past W5 and W10 (the gate review of 10e,
# G1 to G4 and G8; toybox patch 0003). G1: a range and a class that pass the
# end of tr's set buffer. G2: a NUL in SET2. G3: a read error on standard
# input ends tr. G4: expr fails on overflow.
> s=$(printf 'ab\\001-\\377'); echo hi | tr "$s" y; echo "G1A=$?"; z=$(printf '%0250d' 0); echo hi | tr "$z[:punct:]" y; echo "G1B=$?"\r
< yyyG1A=0
< hi
< G1B=0
< PSURF>
> echo abc | tr abc 'x\\000y' | tr '\\000' N; echo "G2=$?"\r
< \nxNy
< G2=0
< PSURF>
> tr a b < /tmp; echo "G3=$?"\r
< tr: read
< G3=1
< PSURF>
