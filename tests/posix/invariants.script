< t_posix: statuses passed
< PSURF>
> t_posix blocked\r
< t_posix: blocked passed
< PSURF>
> t_posix raise\r
< t_posix: raise passed
< PSURF>
> t_posix execmask\r
< t_posix: execmask passed
< PSURF>
> t_posix eintr\r
< t_posix: eintr passed
< PSURF>
# INV-0104-5 and INV-0106-2: no broker message and no request taken on the
# file paths of a process with no handler.
> ZORAYA_POSIX_STATS=1 t_posix files\r
< t_posix: files passed
< broker=0 takes=0 futex=0
< PSURF>
# ADR-0210: the functions the workloads' own programs need.
> t_posix products\r
< t_posix: products passed
< PSURF>
# INV-0191-1 through the services.
> t_posix time\r
< t_posix: time passed
< PSURF>
# INV-0105-1: one Ctrl-C reaches the three of the foreground job and neither
# of the background job.
> (t_posix intcount b1 & t_posix intcount b2 & wait) &\r
< ready
< ready
> t_posix intcount f1 | t_posix intcount f2 | t_posix intcount f3\r
< ready
< ready
< ready
> \x03
< interrupts=1
< interrupts=1
< interrupts=1
< PSURF>
> kill %1; wait; echo background-ended\r
< interrupts=0
< interrupts=0
< background-ended
< PSURF>
# dash's builtin read from a here-document and from a pipe, and a script
# piped into sh (dash's input from a pipe; ports/Makefile, --disable-tee),
# then GNU config.sub's alias table, which reads its argument that way.
> printf 'IFS=- read a b <<EOF\\nx-y\\nEOF\\necho "HEREDOC[$a/$b]"\\n' > /tmp/rd.sh; sh /tmp/rd.sh\r
< HEREDOC[x/y]
< PSURF>
> echo x-y | (IFS=- read a b; echo "PIPE[$a/$b]")\r
< PIPE[x/y]
< PSURF>
> echo 'echo PIPED-$((40 + 2))' | sh\r
< PIPED-42
< PSURF>
> sh /work/w4-g/build-aux/config.sub sun4\r
< sparc-sun-sunos4.1.1
< PSURF>
# toybox's expr (ADR-0336 item 2; it has no stage 6 workload): arithmetic,
# a match, a comparison, and the exit status of a zero result, as
# configure scripts use them.
> echo "E[$(expr 6 \\* 7)][$(expr 17 % 5 - 1)][$(expr foo.c : '.*\\.c')][$(expr abc \\< abd)]"; expr 3 - 3; echo "Z$?"\r
< E[42][1][5][1]
< \n0
< Z1
< PSURF>
# sed -i whose copy back fails (the 64K limit of /limited) keeps the edited
# text in /tmp and says where (toybox patch 0002; review of 10e, finding 17).
> yes abcdefghij | head -n 3700 > /limited/big; sed -i 's/.*/&&/' /limited/big; echo "SED=$?"; cat /tmp/toybox-* | wc -c; rm -f /tmp/toybox-* /limited/big\r
< the edited text is kept in /tmp/toybox-
< SED=1
< 77700
< PSURF>
> exit\r
< BROKER-STATS
