# Scenarios of the POSIX session beyond the workloads (TASK-21): SIGPIPE on
# PeerClosed, make with two rules through /bin/sh (stage 6d's criterion),
# Ctrl-Z, and the hostile cases. W9 and W10, TASK-02b's event sequences,
# are w9-int.script, w9-term.script and w10.script (ADR-0110 items 2 and 4).
! -FAIL
! panicked
! ZORAYA-PANIC
! ZORAYA-FAULT
! t_posix: FAIL
< PSURF>
# A writer killed by SIGPIPE on PeerClosed.
> yes | head -n 1; echo "statuses ${?}"\r
< y
< statuses 0
< PSURF>
# make with two rules through /bin/sh (ADR-0109; stage 6d's criterion).
> cd /home\r
< PSURF>
> printf 'all: b\\nb: a\\n\\tcat a > b\\na:\\n\\techo made > a\\n' > Makefile\r
< PSURF>
> make && cat b\r
< echo made > a
< cat a > b
< made
< PSURF>
> make; echo again=$?\r
< Nothing to be done
< again=0
< PSURF>
# Ctrl-Z (plan.md's risk): the broker's job_suspend of the foreground group,
# fg's tcsetpgrp and SIGCONT; the group stopped whole runs its next child
# after fg (review R1); then Ctrl-C of the continued job. Ctrl-Z goes only
# once the job holds the terminal: before its tcsetpgrp it is the shell's,
# which ignores it, as on any POSIX system (on CI's slow runner 700 ms after
# Enter was too soon, docs/backlog.md). The job says so with a word the
# echoed line does not hold (printf's \146 is "f"), and Ctrl-Z goes the
# moment it shows, while sh is starting sleep: the tightest timing.
> sh -c 'printf "in\\146g\\n"; sleep 5; echo first; sleep 1; echo second; sleep 30'\r
< infg
> \x1a
< Stopped
< PSURF> 
> jobs\r
< Stopped
< PSURF> 
> fg\r
< first
< second
~ 500 PSURF>
> \x03
< PSURF> 
> echo after=$?\r
< after=130
< PSURF> 
# Twice more at the same timing, each stopped and continued (the word
# printed, end1, is not in the line fg echoes).
> sh -c 'printf "in\\146g\\n"; sleep 2; echo end$((0+1))'\r
< infg
> \x1a
< Stopped
< PSURF> 
> fg\r
< end1
< PSURF> 
> sh -c 'printf "in\\146g\\n"; sleep 2; echo end$((1+1))'\r
< infg
> \x1a
< Stopped
< PSURF> 
> fg\r
< end2
< PSURF> 
# Hostile: a process that ignores every catchable signal. Ctrl-C reaches it
# and is ignored; job_kill (kill -9) always ends it.
> /bin/t_posix hostile &\r
< hostile ignoring every signal
> kill -INT $!; kill -TERM $!; kill -HUP $!; sleep 1; jobs\r
< Running
< PSURF>
> kill -9 %1; wait %1; echo killed=$?\r
< killed=137
< PSURF>
# A fork bomb, bounded by the session job's process limit (ADR-0261, ADR-0263
# item 4): fork fails with EAGAIN, and then the session goes on.
> t_posix forkbomb 400\r
< t_posix: forkbomb made
< before Resource temporarily unavailable
< t_posix: forkbomb passed
< PSURF>
> echo still-here\r
< still-here
# A disk filler in a limited directory (ADR-0265, Q5; the ports have no dd):
# its writes stop at the limit with EDQUOT, rm still works at the limit, a
# directory does not cross the limit's boundary (EXDEV), and a write outside
# the limit still works.
> t_posix diskfill /limited /home\r
< t_posix: diskfill wrote 15 blocks before Quota exceeded
< t_posix: diskfill passed
< PSURF>
> echo outside > /home/outside && cat /home/outside && ls /limited; echo done\r
< outside
< done
< PSURF>
> exit\r
< BROKER-STATS
