# The stage 6d session in the stage 5 terminal window (TASK-21): ttyd's window
# backend between the GUI terminal and dash, keys typed into the window
# through QMP and the screen read back as text (tools/test-runner/src/gui.rs).
# Lines are typed whole: under TCG term once dropped the tail of a long
# burst on its way to ttyd; it now holds keys until ttyd reads (TASK-24 7a).
serial init: /etc/zoraya/session: a POSIX session
screen PSURF> _
type echo hi|tr h H\r
screen Hi
screen PSURF> _
type echo the quick brown fox jumps over the lazy dog | tr a-z A-Z\r
screen THE QUICK BROWN FOX JUMPS OVER THE LAZY DOG
screen PSURF> _
type cd /src/gui\r
screen PSURF> _
type echo a > f\r
screen PSURF> _
type cat < f\r
screen a
screen PSURF> _
type sleep 2 & jobs\r
screen [1] + Running                    sleep 2
screen PSURF> _
type wait; echo w=$?\r
screen w=0
# Ctrl-C of a foreground sleep: 130.
type sleep 30\r
chord ctrl c
screen PSURF> _
# The leading newline puts the status on a row of its own even when the keys
# arrive before dash has drawn its prompt again (type-ahead, under TCG).
type echo "\\ns=$?"\r
screen s=130
screen PSURF> _
type make\r
screen made
screen PSURF> _
type exit\r
exit
