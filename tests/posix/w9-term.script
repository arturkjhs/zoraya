# W9, SIGTERM (ADR-0110 item 4): W8 at -j4 in the background, its pid in a
# file, and SIGTERM to that top make alone after 1.5 s, as
# tools/posix-surface/remote/w9_session.py sent it; status 143, no partial
# target and no process left.
! -FAIL
! panicked
! ZORAYA-FAULT
< PSURF> 
> cd /work/w9-term && make -j4 >/dev/null 2>&1 & echo $! > /tmp/make.pid\r
% boot
< PSURF> 
> sleep 1.5; kill -TERM $(cat /tmp/make.pid); wait $(cat /tmp/make.pid); echo W9-STATUS $?\r
< W9-STATUS 143
< PSURF> 
% w9-term
> sh /tests/w9-check.sh /work/w9-term\r
< W9-PARTIAL 0
< PSURF> 
> sleep 0.5; t_posix live 3000\r
< W9-LEFT 0
< PSURF> 
> exit\r
< POSIX-STATS images=
< POSIX-CALLS
< BROKER-STATS
