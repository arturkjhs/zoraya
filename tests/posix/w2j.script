# W2-j (ADR-0110 items 2 and 6): Lua with GNU make at -j2 and -j4, both
# jobserver styles.
! -FAIL
! panicked
! ZORAYA-FAULT
< PSURF> 
> sh /tests/w2.sh parallel\r
% boot
< W2-OK w2j-pipe-j2
% w2j-pipe-j2
< W2-OK w2j-fifo-j2
% w2j-fifo-j2
< W2-OK w2j-pipe-j4
% w2j-pipe-j4
< W2-OK w2j-fifo-j4
% w2j-fifo-j4
< W2-STATUS 0
< PSURF> 
> exit\r
< POSIX-STATS images=
< POSIX-CALLS
< BROKER-STATS
