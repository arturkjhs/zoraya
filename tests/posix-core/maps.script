# Plan part F5 (ADR-0415 item 1, INV-0415-1): 4096 mappings per process, from C
# through libposix, in a 2 GiB guest (make test-libposix boots this script with
# --mem 2G). The plan's CPython command is run by `make test-python-mem` (tests/python/mappings.py).
! panicked
! ZORAYA-PANIC
! t_maps: line
< \r\n~> 
> posixrun /bin/t_maps limit\r
< t_maps: limit passed
< posixrun: exit 0
< \r\n~> 
> posixrun /bin/t_maps heap\r
< t_maps: heap passed
< posixrun: exit 0
< \r\n~> 
> posixrun /bin/t_maps arenas\r
< t_maps: arenas passed
< posixrun: exit 0
< \r\n~> 
> poweroff\r
