# The stage 6d criterion (TASK-21, docs/research/stage-6/plan.md row 6d): dash
# from 6b interactive on the serial console through ttyd and the broker, with
# pipes, redirections, background jobs and Ctrl-C of a foreground sleep, and
# make running a two-rule makefile through /bin/sh. The steps follow W5's
# measured session (ADR-0110 item 3).
! panicked
! ZORAYA-PANIC
! ZORAYA-FAULT
! Fault
< PSURF>
# The session's environment and identity (ADR-0104 item 12).
> cd "$HOME" && pwd && echo "$TERM $SHELL"\r
< /home
< dumb /bin/sh
< PSURF>
# A pipe through two programs (ADR-0101): the writer's end goes, the
# reader sees end of file.
> echo hello world | tr a-z A-Z | wc -c\r
< 12
< PSURF>
# Redirections: a file made, appended to, read back, and a glob.
> echo one > f1.txt; echo two >> f1.txt; cat < f1.txt\r
< one
< two
< PSURF>
> touch f2.txt f3.txt; ls f*.txt | wc -l\r
< 3
< PSURF>
# The environment through export to a child shell.
> export GREETING=hi; sh -c 'echo $GREETING from $$'\r
< hi from
< PSURF>
# A background job, the jobs list, and wait for it.
> sleep 2 &\r
< PSURF>
> jobs\r
< Running
< PSURF>
> wait; echo waited=$?\r
< waited=0
< PSURF>
# Ctrl-C of a foreground sleep (INV-0105-1): the interrupt reaches the
# foreground job, the shell reports 130.
> sleep 30\r
~ 1500 PSURF>
> \x03
< PSURF>
> echo status=$?\r
< status=130
< PSURF>
# make with two rules through /bin/sh (ADR-0109).
> printf 'all: b\\nb: a\\n\\tcat a > b\\na:\\n\\techo made > a\\n' > Makefile\r
< PSURF>
> make && cat b\r
< echo made > a
< cat a > b
< made
< PSURF>
> make; echo again=$?\r
< Nothing to be done
< again=0
< PSURF>
> exit\r
< BROKER-STATS
